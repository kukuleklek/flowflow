# Browser (bundled into the public JS)
VITE_PRIVY_APP_ID=
VITE_PERP_BACKEND=mock
VITE_MAX_MARGIN_USDC=20
VITE_PERP_BUILDER_ADDRESS=
VITE_PERP_BUILDER_FEE=

# Server only (api/chat.js). Never prefix these with VITE_.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash-lite
LLM_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_API_KEY=

# Server only (api/relay-quote.js): Relay needs a key on every quote. dashboard.relay.link -> API keys. Never VITE_.
RELAY_API_KEY=

# Server only: voice mode (api/realtime-session.js) mints short-lived OpenAI Realtime keys from this. Never VITE_.
OPENAI_API_KEY=
# Server only: Tokenomist unlock/emission data (api/tokenomist.js). Never VITE_.
TOKENOMIST_API_KEY=

# Server only: Private mode (api/intents-quote.js, api/intents-status.js). Never VITE_.
# PRIVATE_MODE must be exactly "on" to offer Private; anything else (off, empty, "On") keeps the toggle hidden.
PRIVATE_MODE=off
# Partner key: confidential quotes only with it. Without it quotes are public and the screen says "Preview · not private yet".
NEAR_INTENTS_JWT=
# basic | advanced (used only when NEAR_INTENTS_JWT is set).
NEAR_INTENTS_CONFIDENTIALITY=basic
# Optional: can only LOWER the caps (500 per move, 1000 per wallet per UTC day), never raise them.
INTENTS_MAX_TX_USDC=
INTENTS_MAX_DAY_USDC=
# Optional: extra sanctioned addresses (comma or space separated), refused before any quote.
INTENTS_SANCTIONS_EXTRA=
# Optional: comma list of https RPCs for the sanctions oracle (default: Arbitrum and Ethereum public RPCs).
INTENTS_SANCTIONS_RPC=
